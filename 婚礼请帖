  <style>
    :root{--ink:#53574a;--pink:#dba7a1;--blush:#f4e1dc;--paper:#fbf7ef;--cream:#f1e8d8;--sage:#a9b7a0;--deep:#536451;--line:#d8cdb9}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:#eee6d9;color:var(--ink);font-family:"Noto Serif SC",serif;letter-spacing:.04em} body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.42;background-image:radial-gradient(#8f806b 0.45px,transparent .6px);background-size:5px 5px;mix-blend-mode:multiply;z-index:10}
    .page{max-width:1120px;margin:0 auto;background:var(--paper);overflow:hidden;box-shadow:0 10px 40px #5b4c3630}.hero{min-height:770px;position:relative;padding:34px 7% 70px;background:linear-gradient(178deg,#f7efe2 0%,#f8f4eb 63%,#e6eddf 100%);overflow:hidden}.topline{display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:.16em;color:#68705f}.seal{width:34px;height:34px;border:1px solid var(--pink);border-radius:50%;display:grid;place-items:center;font-family:"Cormorant Garamond";font-size:20px;color:var(--pink)}
    .hero-copy{text-align:center;position:relative;z-index:2;margin-top:75px}.eyebrow{font-size:12px;letter-spacing:.36em;color:#9a8376;margin-bottom:20px}.hero h1{font-size:clamp(49px,7vw,83px);font-weight:500;line-height:.9;letter-spacing:.05em;margin:0;color:#4f594e}.hero h1 em{font-family:"Cormorant Garamond";font-size:.58em;font-style:italic;font-weight:500;letter-spacing:.08em;display:block;margin:13px 0;color:#ba8684}.hero p{font-size:14px;line-height:2;margin:26px auto 0;max-width:360px}.date-line{display:flex;align-items:center;gap:14px;justify-content:center;margin-top:32px;color:#9a6f70;font-family:"Cormorant Garamond";font-size:19px;letter-spacing:.14em}.date-line:before,.date-line:after{content:"";display:block;width:37px;border-top:1px solid #cb9e98}
