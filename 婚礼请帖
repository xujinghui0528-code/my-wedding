    section{padding:100px 8%;position:relative}.section-label{text-align:center;color:#b17f7e;font:500 15px/1 "Cormorant Garamond";letter-spacing:.3em;text-transform:uppercase}.section-title{text-align:center;font-size:29px;font-weight:500;letter-spacing:.16em;margin:16px 0 46px;color:#526050}.section-title:after{content:"✦";font-size:12px;color:#ce9692;display:block;margin-top:17px}
    .note{max-width:670px;margin:auto;text-align:center;line-height:2.15;font-size:14px}.timeline{position:relative;max-width:720px;margin:58px auto 0}.timeline:before{content:"";position:absolute;left:94px;top:12px;bottom:12px;border-left:1px dashed #c5b49b}.event{display:grid;grid-template-columns:96px 44px 1fr;align-items:center;min-height:87px}.time{font:500 27px "Cormorant Garamond";letter-spacing:.03em;color:#b47f7d}.dot{width:14px;height:14px;border:1px solid #cf9b95;background:var(--paper);border-radius:50%;position:relative;z-index:1}.event:first-child .dot{background:#cf9b95;box-shadow:0 0 0 5px #f2dcd7}.event h3{margin:0 0 7px;font-size:16px;font-weight:500}.event p{margin:0;font-size:12px;color:#887f72}.place{background:#eef2e9;padding-top:94px}.place-grid{display:grid;grid-template-columns:1.18fr .82fr;gap:60px;align-items:center;max-width:870px;margin:auto}.sketch{background:#e5ecdf;border:1px solid #cad5c4;padding:15px;transform:rotate(-1.2deg);box-shadow:5px 6px 0 #d9d1c1}.sketch svg{display:block;width:100%;height:auto}.place-copy h3{font-size:27px;font-weight:500;margin:0 0 18px;letter-spacing:.12em}.place-copy p{font-size:13px;line-height:2.2;margin:0 0 25px}.address{border-left:2px solid var(--pink);padding:9px 0 9px 17px;font-size:12px;line-height:1.9}.weather{display:flex;gap:12px;align-items:center;background:#faf7ee;padding:14px 16px;margin-top:25px;font-size:12px;line-height:1.65}.weather b{font-size:24px;font-weight:400}
    .attire{background:#fbf4ee}.attire-intro{text-align:center;font-size:13px;line-height:2;margin:-20px auto 43px;max-width:570px}.looks{display:grid;grid-template-columns:repeat(3,1fr);gap:23px;max-width:870px;margin:auto}.look{background:#fffdf8;border:1px solid #eadfd1;padding:19px;text-align:center;position:relative}.look:before{content:"";position:absolute;inset:7px;border:1px dashed #ead5cd;pointer-events:none}.figure{height:215px;display:grid;place-items:center}.look h3{font-size:16px;font-weight:500;margin:10px 0 6px}.look p{font-size:11px;color:#8c8379;line-height:1.8;margin:0}.palette{display:flex;justify-content:center;gap:9px;margin-top:15px}.palette i{width:13px;height:13px;border-radius:50%;display:block;border:1px solid #fff;box-shadow:0 0 0 1px #d6ccbf}
    .stay{background:var(--cream);text-align:center}.stay-card{max-width:710px;margin:auto;background:#fffaf1;padding:44px 9%;border:1px solid #e0d1bd;position:relative}.stay-card:before,.stay-card:after{content:"❦";position:absolute;color:#c69591;font-size:24px}.stay-card:before{left:19px;top:15px}.stay-card:after{right:19px;bottom:15px;transform:rotate(180deg)}.stay-card p{font-size:13px;line-height:2.1;margin:13px 0}.stay-card strong{font-weight:600;color:#a26f70}.rsvp{padding-bottom:110px;background:#f8f7ef}.form-wrap{max-width:680px;margin:auto}.form-row{margin-bottom:25px}.question{font-size:15px;margin-bottom:12px}.options{display:flex;flex-wrap:wrap;gap:10px}.option input{position:absolute;opacity:0}.option span{display:block;padding:9px 16px;border:1px solid #d7cbbd;border-radius:22px;font-size:13px;cursor:pointer;background:#fffdf8;transition:.2s}.option input:checked+span{border-color:#c88887;background:#f2d8d4;color:#8c6061}.arrival{width:100%;background:transparent;border:0;border-bottom:1px solid #cfc3b3;padding:12px 2px;font:13px "Noto Serif SC";color:var(--ink);outline:none}.submit{display:block;margin:40px auto 0;border:0;background:#586b57;color:white;padding:14px 44px;border-radius:2px;font:14px "Noto Serif SC";letter-spacing:.18em;cursor:pointer;box-shadow:3px 3px 0 #c2cbbd}.submit:hover{transform:translate(1px,1px);box-shadow:1px 1px 0 #c2cbbd}.thanks{display:none;text-align:center;margin-top:24px;color:#a06d6c;font-size:13px}.footer{background:#52624f;color:#edf0e7;text-align:center;padding:34px;font:18px "Cormorant Garamond";letter-spacing:.18em}.footer small{display:block;font:11px "Noto Serif SC";letter-spacing:.12em;margin-top:9px;color:#d5dfd0}
    @media(max-width:700px){.hero{min-height:690px;padding-inline:6%}.hero-copy{margin-top:68px}.place-grid{grid-template-columns:1fr;gap:34px}.place-copy{text-align:center}.address{text-align:left}.looks{grid-template-columns:1fr;max-width:310px}.timeline:before{left:75px}.event{grid-template-columns:77px 36px 1fr}.time{font-size:23px}section{padding:72px 7%}.figure{height:185px}.mountains{height:260px}}
